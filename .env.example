# OpenAI
OPENAI_API_KEY=

# Qdrant Cloud or local Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Local Inngest dev server defaults; override these when deploying to Inngest Cloud.
INNGEST_API_BASE=http://localhost:8288
INNGEST_EVENT_KEY=local
INNGEST_SIGNING_KEY=
# Optional override; if omitted, a signing key enables production mode.
INNGEST_IS_PRODUCTION=false

# Local disk is the default when no bucket URL is configured.
# Set STORAGE_BACKEND=s3 and provide the bucket credentials to use S3-compatible storage.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=data/uploads

# S3-compatible object storage.
# Use s3://bucket-name or https://endpoint.example/bucket-name
STORAGE_BUCKET_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
